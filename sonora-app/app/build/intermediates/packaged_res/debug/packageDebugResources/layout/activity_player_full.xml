<?xml version="1.0" encoding="utf-8"?>
<!-- Reproductor a pantalla completa (estilo Apple Music / Spotify). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fondoDinamico"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_close_full"
            app:title=""
            app:titleTextColor="@color/texto"
            app:menu="@menu/player_menu" />

        <!-- Contenido principal: disco / letras / editor -->
        <FrameLayout
            android:id="@+id/contenedorVista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- VISTA DISCO -->
            <LinearLayout
                android:id="@+id/layoutDisco"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/caratulaCard"
                    android:layout_width="270dp"
                    android:layout_height="270dp"
                    app:cardCornerRadius="135dp"
                    app:cardElevation="18dp">

                    <ImageView
                        android:id="@+id/imgCaratulaFull"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Carátula" />
                </com.google.android.material.card.MaterialCardView>

                <com.sonora.app.WaveView
                    android:id="@+id/waveView"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="26dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtTituloFull"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:textColor="@color/texto"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtArtistaFull"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/texto_suave"
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtAlbumFull"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp"
                    android:alpha="0.8"
                    android:textAlignment="center"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- VISTA LETRAS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerLetras"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtSinLetras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:text="Sin letras disponibles.\nToca ✏️ para añadirlas."
                android:textAlignment="center"
                android:textColor="@color/texto_suave"
                android:lineSpacingExtra="6dp"
                android:visibility="gone" />

            <!-- VISTA EDITOR DE LETRAS -->
            <LinearLayout
                android:id="@+id/layoutLetrasEdit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Editor de letras sincronizadas"
                    android:textColor="@color/texto"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Coloca el cursor en una línea y pulsa «Marcar»: se le añade el tiempo exacto de la canción."
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editLetras"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="10dp"
                    android:background="@color/superficie"
                    android:gravity="top|start"
                    android:hint="Escribe o pega las letras, una línea por verso"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:padding="14dp"
                    android:textColor="@color/texto"
                    android:textColorHint="@color/texto_suave"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMarcarLetra"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⏱ Marcar aquí" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarLetras"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Guardar"
                        android:textColor="@color/texto" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Zona inferior: progreso y controles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_reproductor_inferior"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/texto"
                android:thumbTint="@color/acento"
                android:progressBackgroundTint="@android:color/transparent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/txtPosicion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp"
                    android:text="0:00" />

                <TextView
                    android:id="@+id/txtCola"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/texto_suave"
                    android:textSize="11sp"
                    android:alpha="0.8"
                    android:text="" />

                <TextView
                    android:id="@+id/txtDuracion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp"
                    android:text="0:00" />
            </LinearLayout>

            <!-- Controles principales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <ImageButton
                    android:id="@+id/btnAtras"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_previous"
                    android:contentDescription="Anterior"
                    app:tint="@color/texto" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:background="@drawable/bg_round_primary"
                    android:src="@android:drawable/ic_media_play"
                    android:contentDescription="Play/Pausa"
                    app:tint="@color/texto" />

                <ImageButton
                    android:id="@+id/btnSiguiente"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_next"
                    android:contentDescription="Siguiente"
                    app:tint="@color/texto" />
            </LinearLayout>

            <!-- Herramientas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/btnAhorro"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_battery"
                    android:contentDescription="Ahorro de batería"
                    app:tint="@color/texto_suave" />

                <TextView
                    android:id="@+id/btnVelocidad"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="18dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip"
                    android:text="1,0x"
                    android:textColor="@color/texto"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnLetras"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="18dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_lyrics"
                    android:contentDescription="Letras"
                    app:tint="@color/texto_suave" />

                <ImageButton
                    android:id="@+id/btnEditarLetras"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="18dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_edit"
                    android:contentDescription="Editar letras"
                    app:tint="@color/texto_suave" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
