<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes"
            android:textColor="@color/texto"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/superficie"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servidor"
                    android:textColor="@color/texto"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="URL del servidor Node.js (local o nube)"
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editServidor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="http://IP:8080 o https://tudominio.com"
                        android:inputType="textUri"
                        android:textColor="@color/texto" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarServidor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Guardar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProbar"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Probar"
                        android:textColor="@color/texto" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnServidorMac"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="🏠 Mi Mac (WiFi)"
                        android:textColor="@color/texto"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnServidorNube"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="☁️ Servidor en la nube"
                        android:textColor="@color/texto"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/estadoServidor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/superficie_alta"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:text="Sin comprobar"
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Pega aquí la URL pública que te dio Render (https://....onrender.com) o la IP de tu Mac en la misma WiFi (http://192.168.1.x:8080)."
                    android:textColor="@color/texto_suave"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/superficie"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reproductor"
                    android:textColor="@color/texto"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ahorro batería, visualización y más"
                    android:textColor="@color/texto_suave"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAhorro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modo ahorro batería"
                    android:textColor="@color/texto"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchOndas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mostrar ondas por defecto"
                    android:textColor="@color/texto" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sonora • Android"
            android:textColor="@color/texto_suave"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
